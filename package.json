{
  "name": "fetcher",
  "version": "1.0.0",
  "description": "Dev API Proxy Gateway - bypass CORS and Cookie issues in multi-container setups",
  "type": "module",
  "main": "server/src/index.ts",
  "scripts": {
    "dev:server": "tsx server/src/index.ts",
    "dev:client": "npm run dev --prefix client",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run dev:server\" \"npm run dev:client\"",
    "build:client": "npm run build --prefix client",
    "build": "npm run build:client",
    "start": "tsx server/src/index.ts"
  },
  "keywords": [
    "cors",
    "proxy",
    "gateway",
    "cookies",
    "docker",
    "dev-tools"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^4.21.2",
    "http-proxy": "^1.18.1",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/http-proxy": "^1.17.15",
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
